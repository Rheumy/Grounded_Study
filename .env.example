# Core
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grounded_study"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
EMAIL_FROM="no-reply@grounded-study.local"
ADMIN_EMAIL=""
ADMIN_JOB_TOKEN=""
CRON_SECRET=""
CRON_INGESTION_BATCH_SIZE="3"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Dev auth bypass (optional, local only)
DEV_AUTH_BYPASS="false"
DEV_AUTH_EMAIL="student@example.com"
NEXT_PUBLIC_DEV_AUTH_BYPASS="false"

# OpenAI (optional, required for ingestion/LLM)
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
OPENAI_PROJECT_ID=""

# Storage
UPLOADS_DIR="./uploads"
BLOB_READ_WRITE_TOKEN=""

# Stripe (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""

# Limits
MAX_UPLOAD_MB="20"
MAX_PDF_PAGES="400"
MAX_IMAGE_PIXELS="25000000"

# Note:
# - On Vercel Hobby, automatic cron processing is disabled unless you add your own supported schedule later.
# - Manual ingestion processing still works through POST /api/admin/process-jobs using ADMIN_JOB_TOKEN.

# Daily plan quotas
# These are daily/user plan limits, not per-generation request caps.
FREE_QUESTIONS_PER_DAY="25"
PRO_QUESTIONS_PER_DAY="200"
FREE_UPLOADS_PER_DAY="5"
PRO_UPLOADS_PER_DAY="50"
FREE_STORAGE_MB="200"
PRO_STORAGE_MB="2000"

# Per-generation request caps
# These control how many questions can be generated in one request.
FREE_MAX_GENERATE_COUNT="25"
PRO_MAX_GENERATE_COUNT="100"
ABSOLUTE_MAX_GENERATE_COUNT="100"

# Upload file size caps in MB
FREE_MAX_UPLOAD_MB="20"
PRO_MAX_UPLOAD_MB="100"
ABSOLUTE_MAX_UPLOAD_MB="250"
